# ExamSecure configuration. Copy to ".env" and adjust.
# Values containing "#" must be quoted.

# Teacher access code (case-sensitive). Verified on the server only.
TEACHER_ACCESS_CODE="12345678abcd#"

# Backend port and bind address. 0.0.0.0 lets pupil devices on the LAN connect.
PORT=3001
HOST=0.0.0.0

# Title shown to pupils and the teacher. Defaults to the PDF file name.
# EXAM_TITLE="CSOK Jesma Edition — Standard 8 Paper 1"

# Defaults for the teacher dashboard (the teacher can change them before opening).
# Examination time limit in minutes (0 = no time limit).
EXAM_DURATION_MINUTES=0
# Automatically close new-device admission N minutes after opening (0 = manual only).
ADMISSION_WINDOW_MINUTES=0

# Number of recorded violations before the serious warning and teacher alert.
VIOLATION_ESCALATION_THRESHOLD=3

# How long a teacher stays signed in.
TEACHER_SESSION_HOURS=12

# Set to true when served over HTTPS so the teacher cookie is marked Secure.
COOKIE_SECURE=false
